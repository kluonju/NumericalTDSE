! Four lowest 1D HO eigenstates. Ground: Lanczos from a displaced Gaussian.
! n≥1: Hermite nodal guess + a few imaginary-time RK4 steps.
! Analytic: E_n = ω (n + 1/2); check |⟨ψ_num|ψ_n⟩| (MW residual can be large).
! 一维谐振子最低四态。基态用 Lanczos；激发态用 Hermite 初猜 + 虚时打磨。
&CONTROL
  calculation = 'eigen'
  title       = '1D HO lowest four eigenstates'
  prefix      = 'eigen_1d'
  ident_check = .false.
  n_states    = 4
/

&MRA
  prec  = 1.0d-4
  order = 7
  L     = 8.0
/

&TIME
  krylov_dim = 16
/

&SYSTEM
  trap  = 'harmonic'
  omega = 1.0
/

&INITIAL
  alpha = 1.0
  x0    = 0.7
/

&EIGEN
  method = 'lanczos'
/

&OUTPUT
  plot = 'eigen_1d'
/
