! 1D harmonic oscillator / 一维谐振子
! Coherent state: alpha = omega = 1, x0 = 1.
! Analytic:  μ(t) = x0 cos(ω t) = cos(t)
!            E    = ω/2 + ½ ω² x0² = 1
!            |⟨ψ_num|ψ_ana⟩| with validate_ho = .true.
&CONTROL
  title       = '1D harmonic oscillator vs coherent state'
  prefix      = 'harmonic_1d'
  ident_check = .false.
  validate_ho = .true.
/

&MRA
  prec  = 1.0d-4
  order = 7
  L     = 8.0
/

&TIME
  dt         = 0.02
  T          = 0.40
  propagator = 'rk4'
/

&SYSTEM
  dim       = 1
  electrons = 1
  trap      = 'harmonic'
  omega     = 1.0
/

&INITIAL
  alpha = 1.0
  x0    = 1.0
/

&OUTPUT
  plot = 'harmonic_1d'
/
