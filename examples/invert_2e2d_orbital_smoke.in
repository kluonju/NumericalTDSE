! 2e-in-2D orbital-CI inversion smoke (ctest). Not a converged potential.
&CONTROL
  calculation = 'invert'
  title       = '2e-2D orbital-CI inversion smoke'
  prefix      = 'invert_2e2d_orbital_smoke'
  ident_check = .false.
/

&MRA
  L = 4.0
/

&SYSTEM
  dim       = 2
  electrons = 2
  trap      = 'harmonic'
  omega     = 1.0
  soft_a    = 1.0
  ee        = .true.
/

&INITIAL
  alpha = 1.0
/

&INVERT
  target  = 'self'
  guess   = 'scaled'
  scale   = 0.6
  basis   = 'orbital'
  n_orb   = 4
  n_grid  = 9
  gamma   = 0.40
  maxiter = 3
  check   = .true.
  tol     = 1.0d-3
/
