! One electron in a 1D soft-Coulomb well. No closed-form TDSE solution;
! watch norm ≈ 1 and a slowly varying energy.
! 一维软库仑原子，无解析 TDSE；检查模方守恒与能量平稳。
&CONTROL
  title       = '1D soft-Coulomb atom'
  prefix      = 'atom_1d'
  ident_check = .false.
/

&MRA
  prec = 1.0d-4
  L    = 12.0
/

&TIME
  dt         = 0.02
  T          = 0.40
  propagator = 'krylov'
/

&SYSTEM
  trap   = 'atom'
  Z      = 1.0
  soft_a = 1.0
/

&INITIAL
  alpha = 1.0
  x0    = 0.0
/

&OUTPUT
  plot = 'atom_1d'
/
