! Exact 1D three-electron TDSE on FunctionTree<3>: ψ(x1,x2,x3).
! Coordinates: r[i] is electron i. Trap ½ω² Σ x_i²; ee=.false. → no V_ee.
! fermion=.true. → Slater of HO orbitals n=0,1,2 (non-interacting GS, E=4.5).
! This is a 3D adaptive tree — keep prec coarse and T short.
! 精确一维三电子（D=3 的树）。ee=.false. 时解析能 E=4.5。
&CONTROL
  title       = 'exact 1D 3e HO (non-interacting fermions)'
  prefix      = 'ho_3e_exact'
  ident_check = .false.
/

&MRA
  prec      = 1.0d-3
  order     = 5
  max_depth = 10
  L         = 6.0
/

&SYSTEM
  dim       = 1
  electrons = 3
  mode      = 'exact'
  trap      = 'harmonic'
  omega     = 1.0
  fermion   = .true.
  ee        = .false.             ! .true. adds 1/sqrt((xi-xj)²+a²)
  soft_a    = 1.0
/

&TIME
  dt         = 0.02
  T          = 0.08
  propagator = 'rk4'
/

&INITIAL
  alpha = 1.0
  x0    = 0.0
/
